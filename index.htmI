<!DOCTYPE html>
<html>
<head>
    <title>Juma's Website</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background: #111;
            color: white;
            padding: 50px;
        }

        h1 {
            font-size: 40px;
        }

        p {
            font-size: 20px;
        }

        button {
            padding: 12px 25px;
            border: none;
            border-radius: 25px;
            font-size: 18px;
            cursor: pointer;
        }
    </style>
</head>

<body>
    <h1>Welcome to My Website 👋</h1>
    <p>My name is Juma Omar.</p>
    <p>Welcome to my personal website.</p>

    <button onclick="alert('Thanks for visiting! ❤️')">
        Click Me
    </button>
</body>
